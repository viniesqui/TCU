# ════════════════════════════════════════════════════════════════════════
# TCU — Variables de Entorno
# ════════════════════════════════════════════════════════════════════════
# Copia este archivo como ".env" y rellena tus llaves reales:
#   cp .env.example .env
#
# NUNCA subas el archivo .env al repositorio.
# ════════════════════════════════════════════════════════════════════════

# ── Llaves de API (obligatoria solo la primera) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-tu-llave-aqui

# Opcionales — necesarias solo para funciones multimedia (audio y video)
OPENAI_API_KEY=tu-llave-openai-aqui
ELEVENLABS_API_KEY=tu-llave-elevenlabs-aqui
HEYGEN_API_KEY=tu-llave-heygen-aqui

# ── Modelo de IA ────────────────────────────────────────────────────────
MODEL=claude-sonnet-4-6

# ── Límites de costo por agente (USD) ───────────────────────────────────
MAX_RUN_COST=1.00
MAX_COST_RESEARCHER=1.00
MAX_COST_COORDINATOR=1.00
MAX_COST_PROFESSOR=1.00
MAX_COST_STUDENT=1.00

# ── Límites del loop de agentes ────────────────────────────────────────
MAX_AGENT_ITERATIONS=25
MAX_STAGE_RETRIES=2

# ── Búsqueda web ────────────────────────────────────────────────────────
SEARCH_MAX_RESULTS=5

# ── Salida ──────────────────────────────────────────────────────────────
OUTPUT_DIR=output
LOG_LEVEL=INFO

# ── Umbrales de calidad (Quality Gates) ────────────────────────────────
QUALITY_MIN_SKILLS=8
QUALITY_MIN_JOB_POSTINGS=5
QUALITY_MIN_SOURCES=2
QUALITY_MIN_UNIVERSITIES=5
QUALITY_MIN_COURSES_PER_PROGRAM=3
QUALITY_MIN_SKILLS_COVERED=10
