ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL=claude-sonnet-4-5

# Agent loop limits
MAX_AGENT_ITERATIONS=12
MAX_STAGE_RETRIES=2

# Web search
SEARCH_MAX_RESULTS=5

# Output
OUTPUT_DIR=output
LOG_LEVEL=INFO

# Quality gate thresholds (lower these for faster/cheaper runs during development)
QUALITY_MIN_SKILLS=8
QUALITY_MIN_JOB_POSTINGS=2
QUALITY_MIN_SOURCES=2
QUALITY_MIN_UNIVERSITIES=3
QUALITY_MIN_COURSES_PER_PROGRAM=3
QUALITY_MIN_SKILLS_COVERED=10
